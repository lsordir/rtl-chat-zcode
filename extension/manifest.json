{
  "manifest_version": 3,
  "name": "RTL Chat for ZCode",
  "version": "0.3.4",
  "description": "راست‌چین هوشمند (any-rtl) پیام‌ها با دکمه خاموش/روشن و فونت وزیرمتن در ZCode Desktop",
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["rtl-chat.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["<all_urls>", "file:///*"]
}
